{
  "name": "quanta-crypto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "dev:server": "tsx watch server.ts",
    "dev:client": "vite",
    "dev:all": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit && eslint server src tests --quiet",
    "test": "QUANTA_TEST=1 node --import tsx --test \"tests/*.test.js\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^6.0.5",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3"
  }
}
