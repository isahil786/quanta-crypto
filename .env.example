# Server
PORT=3000
# Bind address. Defaults to 127.0.0.1 (local only). Use 0.0.0.0 only together with API_TOKEN.
# HOST=127.0.0.1
# Optional: require "Authorization: Bearer <token>" (or x-api-token) on every /api request.
# API_TOKEN=change-me
# Force every bot onto the halal coin list (otherwise the UI toggle decides).
# HALAL_ONLY=true
# Persist paper-trading state across restarts (API keys are never written). Omit to keep state in memory only.
# STATE_FILE=./data/state.json
# Per-IP /api rate limit (requests per minute).
# RATE_LIMIT_PER_MIN=600

# Seed accounts file (user-editable plaintext JSON). On startup, accounts here
# are loaded into the engine. Keys are stored plaintext — fine for local-only
# use; never commit real credentials.
# ACCOUNTS_FILE=./data/accounts.json

# Live trading is OFF unless this is true. REAL-mode accounts cannot send orders otherwise.
# LIVE_TRADING=true
# Per-order notional cap for live orders, in USDT (default 50). Raise it once you trust the setup.
# LIVE_MAX_ORDER_USDT=50
# Display-only USDT/INR rate if CoinDCX's ticker is unreachable from your machine.
# USDT_INR_RATE=
