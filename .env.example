# Server
PORT=3000
# Bind address. Defaults to 127.0.0.1 (local only). Use 0.0.0.0 only together with API_TOKEN.
# HOST=127.0.0.1
# Optional: require "Authorization: Bearer <token>" (or x-api-token) on every /api request.
# API_TOKEN=change-me
# Force every bot onto the halal coin list (otherwise the UI toggle decides).
# HALAL_ONLY=true
